# -*- mode: yaml -*-
# gitStream rules for this repo. Docs: https://docs.gitstream.cm
#
# GUARDRAILS use request-changes@v1, which fails gitStream's check until the
# problem is fixed (gitStream clears the request by itself once it no longer
# applies). For that to actually block a merge, add gitStream as a required
# check on main (GitHub ruleset). Each guardrail names a label you can add to
# override it on purpose.
manifest:
  version: 1.0

automations:
  # ======================= Guardrails =======================

  # 1. Every PR must reference a Jira work item (e.g. KAN-12)
  guardrail_jira_key:
    if:
      - {{ not is.bot }}
      - {{ not has.jira_key }}
    run:
      - action: add-label@v1
        args:
          label: "missing-jira"
          color: {{ colors.red }}
      - action: request-changes@v1
        args:
          comment: |
            **No Jira work item linked.** Put a key from {{ jira.projects | join(", ") }} in the **PR title** (e.g. `KAN-12: Add login`) or the **branch name** (e.g. `KAN-12-add-login`).
            That links this PR, its builds and its deployment to the item in Jira. The *Jira ticket* CI check also confirms the item exists.

  # Link the Jira item(s) found, so reviewers can open them in one click
  link_jira_ticket:
    if:
      - {{ has.jira_key }}
    run:
      - action: add-comment@v1
        args:
          comment: |
            Jira: [{{ jira.key }}]({{ jira.base_url }}{{ jira.key }})

  # 2. App code changed without any test change
  guardrail_missing_tests:
    if:
      - {{ not is.bot }}
      - {{ has.app_changes }}
      - {{ not has.test_changes }}
      - {{ pr.labels | match(term='tests-not-needed') | nope }}
    run:
      - action: add-label@v1
        args:
          label: "missing-tests"
          color: {{ colors.yellow }}
      - action: request-changes@v1
        args:
          comment: |
            **Tests missing.** This PR changes code in `app/` but nothing in `tests/`.
            Add or update a test, or add the `tests-not-needed` label if this change really needs none.

  # 3. Delivery files need a deliberate sign-off
  guardrail_delivery_files:
    if:
      - {{ has.delivery_changes }}
      - {{ pr.labels | match(term='deploy-reviewed') | nope }}
    run:
      - action: add-label@v1
        args:
          label: "ci-cd-change"
          color: {{ colors.red }}
      - action: request-changes@v1
        args:
          comment: |
            **Delivery files changed:** {{ files | filter(regex=delivery_files) | join(", ") }}
            These control how the site is built, deployed and edited. Check the change, then add the `deploy-reviewed` label to clear this.

  # 4. Oversized PRs are hard to review well
  guardrail_large_pr:
    if:
      - {{ not is.bot }}
      - {{ calc.etr > limits.review_minutes }}
      - {{ pr.labels | match(term='large-pr-ok') | nope }}
    run:
      - action: request-changes@v1
        args:
          comment: |
            **Large PR:** about {{ calc.etr }} minutes to review (limit {{ limits.review_minutes }}).
            Split it into smaller PRs, or add the `large-pr-ok` label if it can't be split.

  # 5. Something in the added lines looks like a secret
  guardrail_possible_secret:
    if:
      - {{ has.possible_secret }}
      - {{ pr.labels | match(term='not-a-secret') | nope }}
    run:
      - action: add-label@v1
        args:
          label: "possible-secret"
          color: {{ colors.red }}
      - action: request-changes@v1
        args:
          comment: |
            **Possible secret in the code.** A line you added looks like a key, token, password or DSN.
            Keep secrets in Render's Environment page or GitHub Actions secrets, never in the repo.
            If it's a false alarm (e.g. a test value), add the `not-a-secret` label.

  # 6. Security scan found problems (Bandit or SonarQube Cloud)
  # The Security workflow posts one comment whose first line is a marker like
  # <!-- security-summary bandit_high=0 bandit_medium=0 bandit_low=0 sonar_gate=OK -->
  # Posting or updating it re-runs gitStream (comment_added), which reads it here.
  guardrail_security_scan:
    on: [comment_added, commit, pr_created, label_added, label_removed]
    if:
      - {{ has.security_problems }}
      - {{ pr.labels | match(term='security-reviewed') | nope }}
    run:
      - action: add-label@v1
        args:
          label: "security-issues"
          color: {{ colors.red }}
      - action: request-changes@v1
        args:
          comment: |
            **Security scan found problems.** See the *Security scan* comment below for the Bandit findings or the failed SonarQube Cloud quality gate.
            Fix them, or add the `security-reviewed` label if you've checked they're false positives.

  # ==================== Helpers (non-blocking) ====================

  # LinearB AI code review on every non-bot PR
  linearb_ai_codereview:
    on: [pr_created, pr_ready_for_review, merge]
    if:
      - {{ not is.bot }}
    run:
      - action: code-review@v1
        args:
          guidelines: |
            - Keep suggestions short and actionable.
            - This is a FastAPI app: flag missing input validation, blocking calls in async code and endpoints without tests.

  # AI-written PR description + estimated review time label
  describe_and_estimate:
    on: [pr_created, commit]
    if:
      - {{ not pr.draft }}
      - {{ not is.bot }}
    run:
      - action: describe-changes@v1
        args:
          concat_mode: append
      - action: add-label@v1
        args:
          label: "{{ calc.etr }} min review"
          color: {{ colors.red if (calc.etr >= 20) else (colors.yellow if (calc.etr >= 5) else colors.green) }}

  # Docs-only PRs are low risk
  docs_only:
    if:
      - {{ files | allDocs }}
    run:
      - action: add-label@v1
        args:
          label: "docs-only"
          color: {{ colors.green }}

# ----------------- config -----------------
jira:
  # Jira projects whose keys count as a link. Add new project keys here.
  projects: [KAN, SAM1]
  base_url: https://vicuong.atlassian.net/browse/
  key: {{ pr.title | capture(regex=r/\b(KAN|SAM1)-\d+\b/) or branch.name | capture(regex=r/\b(KAN|SAM1)-\d+\b/) }}

limits:
  review_minutes: 30

delivery_files: r/^(\.github\/workflows\/|\.cm\/|\.jira\/|Dockerfile$|docker-compose\.yml$|render\.yaml$|\.pages\.yml$)/

calc:
  etr: {{ branch | estimatedReviewTime }}

has:
  jira_key: {{ (pr.title | includes(regex=r/\b(KAN|SAM1)-\d+\b/)) or (branch.name | includes(regex=r/\b(KAN|SAM1)-\d+\b/)) or (pr.description | includes(regex=r/atlassian\.net\/browse\/(KAN|SAM1)-\d+/)) }}
  app_changes: {{ files | match(regex=r/^app\//) | some }}
  test_changes: {{ files | match(regex=r/^tests\//) | some }}
  delivery_changes: {{ files | match(regex=delivery_files) | some }}
  # Latest security summary comment from the Security workflow (empty if none yet)
  security_problems: {{ pr.comments | filter(attr='content', regex=r/security-summary/) | filter(attr='content', regex=r/(bandit_(high|medium)=[1-9]|sonar_gate=ERROR|sonar_vulnerabilities=[1-9])/) | some }}
  possible_secret: {{ source.diff.files | matchDiffLines(regex=r/^\+.*((api[_-]?key|secret|token|passw(or)?d|dsn)\s*[:=]\s*["']?[A-Za-z0-9_\-\/+.@:]{16,}|ghp_[A-Za-z0-9]{20,}|sk-[A-Za-z0-9]{20,}|AKIA[0-9A-Z]{16})/, caseSensitive=false) | some }}

is:
  bot: {{ pr.author | match(list=['github-actions','_bot_','[bot]','dependabot','gitstream-cm']) | some }}

colors:
  red:    'b60205'
  yellow: 'fbca04'
  green:  '0e8a16'
