# Cloudflare Flagship feature flags.
# The app and account IDs are already built into the Docker image; you only
# need the API token (a Cloudflare token with the Flagship Evaluate permission).
# Without it the app runs with the flag defaults in app/flags.py.
FLAGSHIP_API_TOKEN=
# Seconds to cache flag results (default 30)
FLAGSHIP_CACHE_TTL=30
# Only set these to point at a different Flagship app:
# FLAGSHIP_APP_ID=
# CLOUDFLARE_ACCOUNT_ID=

# Sentry error tracking (optional): your Sentry project's DSN
SENTRY_DSN=
# Share of requests sent to Sentry as performance traces, 0.0-1.0
SENTRY_TRACES_SAMPLE_RATE=0.1

# OpenTelemetry traces and metrics (optional), e.g. to Grafana Cloud.
# Both values come from Grafana Cloud > your stack > OpenTelemetry > Configure.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=python-web-app

# Set to true to enable /api/debug/error, which crashes on purpose to test Sentry
ENABLE_DEBUG_ENDPOINTS=false
